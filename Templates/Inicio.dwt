        <script>
/* Inicio: la "propiedad destacada" muestra al azar hasta 6 propiedades del catálogo en cada visita (data-max) */
(function () {
    var wrapper = document.querySelector('.banner-destacada .swiper-wrapper');
    if (!wrapper) { return; }
    var slides = [], i, j, t;
    for (i = 0; i < wrapper.children.length; i++) { if (wrapper.children[i].className.indexOf('swiper-slide') > -1) { slides.push(wrapper.children[i]); } }
    for (i = slides.length - 1; i > 0; i--) { j = Math.floor(Math.random() * (i + 1)); t = slides[i]; slides[i] = slides[j]; slides[j] = t; }
    var max = parseInt(wrapper.getAttribute('data-max'), 10) || 6;
    for (i = 0; i < slides.length; i++) { if (i < max) { wrapper.appendChild(slides[i]); } else { wrapper.removeChild(slides[i]); } }
})();
</script>
<script type="text/javascript" src="../js/main.js"></script>
    <script type="text/javascript" src="../js/sitio.js"></script>
